#
# One OS user per operator, so a Session Manager document can run each session
# as its owner, and none of them with sudo -- the bastion is a jump host, not an
# identity. Applied by State Manager on every start and whenever the operator
# list changes; safe to repeat.
set -euo pipefail
# An operator account carries a marker in its GECOS field. An account that
# already exists without it is never adopted: a session document must not run as it.
%{ for user in operators ~}
if id -u "${user}" >/dev/null 2>&1; then
  [ "$(getent passwd "${user}" | cut -d: -f5)" = "bastion-operator" ] \
    || { echo "refusing to adopt existing account '${user}': not a bastion operator account" >&2; exit 1; }
else
  useradd --create-home --shell /bin/bash --comment bastion-operator "${user}"
fi
%{ endfor ~}
