#
# First boot only, and deliberately static: nothing here ever changes after the
# instance exists, so no configuration change stops the instance and ends the
# sessions on it. Operators, tools and the banner are delivered by State
# Manager associations instead (bastion.tf), which run on every start and
# whenever their content changes, without a reboot.
set -euo pipefail
printf '%s\n' 'Bastion. Sessions are recorded. Sign in with your own identity before' 'touching anything:  aws sso login --profile <profile>  (device flow)' > /etc/motd
